{
  "name": "@x-cmd/draw",
  "version": "0.1.0",
  "description": "SVG chart rendering as a service, a library, and a CLI — pie/bar/hbar/line/area/radar/gauge/scatter/combo/sankey/qr, same params everywhere",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "default": "./dist/lib.js"
    }
  },
  "bin": {
    "x-draw": "./dist/node/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.19"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.build.json",
    "serve": "tsx src/node/server.ts",
    "start": "npm run serve",
    "cli": "tsx src/node/cli.ts",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "setup": "bash scripts/setup.sh",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "d3-array": "^3.2.4",
    "d3-sankey": "^0.12.3",
    "d3-scale": "^4.0.2",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@types/d3-array": "^3.2.2",
    "@types/d3-sankey": "^0.12.5",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.0.0"
  }
}
