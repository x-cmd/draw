{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "draw-lib",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "DATA_REPO": "x-cmd-hub/draw-charts",
    "DATA_BRANCH": "charts"
  },
  // POST /draw 全局限流(每 CF 数据中心独立计数,binding 原生支持,替代内存 Map)
  "ratelimits": [
    { "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }
  ]
  // 不绑 x-cmd.com 路由:生产域名归 x-cmd-hub/draw 的同名 worker 独占,
  // 本仓库部署只走 workers.dev(draw-lib.<account>.workers.dev),
  // 防止误部署覆盖线上页面层(2026-11-01 事故:同名 worker + 同 route 互相顶掉)
}
